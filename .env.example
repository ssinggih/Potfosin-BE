# ===========================================
# PORTFOLIO BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# APP
NODE_ENV=development
PORT=3000

# API GATEWAY
GATEWAY_PORT=3000
GATEWAY_PREFIX=api/v1

# PORTFOLIO MICROSERVICE
PORTFOLIO_SERVICE_HOST=0.0.0.0
PORTFOLIO_SERVICE_PORT=3001
PORTFOLIO_SERVICE_TCP_PORT=4001

# POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=potfosin

# REDIS (optional — falls back to in-memory cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# CLOUDFLARE R2 (file uploads)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=portfosin-image
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# RATE LIMIT
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:5173
