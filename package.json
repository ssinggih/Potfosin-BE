{
  "name": "potfosin-be",
  "version": "1.0.0",
  "description": "Portfolio Backend Microservices with NestJS",
  "license": "ISC",
  "author": "Singgih",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "dev": "nest start api-gateway --watch",
    "dev:portfolio": "nest start portfolio-service --watch",
    "start:prod": "node apps/api-gateway/dist/apps/api-gateway/src/main",
    "start:prod:gateway": "node apps/api-gateway/dist/apps/api-gateway/src/main",
    "start:gateway": "nest start api-gateway --watch",
    "start:portfolio": "nest start portfolio-service --watch",
    "vercel-build": "nest build api-gateway",
    "migrate": "npx ts-node -P tsconfig.json scripts/migrate.ts",
    "seed": "npx ts-node -P tsconfig.json scripts/seed.ts",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@nestjs/cache-manager": "^2.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@vendia/serverless-express": "^4.12.6",
    "bcrypt": "^5.1.1",
    "cache-manager": "^5.3.1",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
